<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F4F46E5">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F4F6FF"
                android:startColor="@color/surface_card"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#C7D2FE" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
