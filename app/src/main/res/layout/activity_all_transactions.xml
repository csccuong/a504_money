<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- Unified Navy Header -->
    <LinearLayout
        android:id="@+id/view_header_bg"
        style="@style/AppContainer.HeaderNavy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_lg"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Row 1: Back + Title + Period Mode Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                style="@style/AppButton.BackHeader"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/AppText.ScreenTitleLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/all_transactions"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/btn_period_mode"
                style="@style/AppButton.HeaderChip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/all_time"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 2: Period Stepper + Result Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/period_stepper"
                layout="@layout/view_period_stepper" />

            <TextView
                android:id="@+id/tv_all_time_indicator"
                style="@style/AppText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_header"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/all_time"
                android:textColor="@color/white"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_result_count"
                style="@style/AppText.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="0 txns"
                android:textColor="@color/brand_on_primary_muted" />
        </LinearLayout>

        <!-- Row 3: 3-Column Filtered Summary Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dayofyear"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_summary_label_1"
                    style="@style/AppText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/income"
                    android:textColor="@color/brand_on_primary_muted" />

                <TextView
                    android:id="@+id/tv_summary_value_1"
                    style="@style/AppText.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:maxLines="1"
                    android:text="+$0"
                    android:textColor="@color/semantic_income_on_dark"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_summary_label_2"
                    style="@style/AppText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expense"
                    android:textColor="@color/brand_on_primary_muted" />

                <TextView
                    android:id="@+id/tv_summary_value_2"
                    style="@style/AppText.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:maxLines="1"
                    android:text="-$0"
                    android:textColor="@color/semantic_expense_on_dark"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="8dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_summary_label_3"
                    style="@style/AppText.Micro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/net_savings"
                    android:textColor="@color/brand_on_primary_muted" />

                <TextView
                    android:id="@+id/tv_summary_value_3"
                    style="@style/AppText.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/roboto_bold"
                    android:maxLines="1"
                    android:text="$0"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:autoSizeMaxTextSize="13sp"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Live Search Bar -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="@dimen/ds_space_lg"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/view_header_bg">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_muted" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/roboto_regular"
            android:hint="@string/search_transactions_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/iv_clear_search"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_close_small"
            android:visibility="gone"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- 4-Way Type Segmented Filter -->
    <LinearLayout
        android:id="@+id/layout_type_filter"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="@dimen/ds_space_lg"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_segmented_track"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@id/search_container">

        <TextView
            android:id="@+id/tab_all"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/all" />

        <TextView
            android:id="@+id/tab_expense"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/expense" />

        <TextView
            android:id="@+id/tab_income"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/income" />

        <TextView
            android:id="@+id/tab_loan"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/loan" />
    </LinearLayout>

    <!-- Category Quick-Filter Bar + Collapse/Expand Toggle -->
    <LinearLayout
        android:id="@+id/row_secondary_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ds_space_lg"
        app:layout_constraintTop_toBottomOf="@id/layout_type_filter">

        <HorizontalScrollView
            android:id="@+id/hsv_categories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ll_category_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btn_toggle_collapse"
            style="@style/AppText.Micro"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/collapse_all"
            android:textColor="@color/brand_primary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 60fps Flat RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_all_transactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/ds_space_lg"
        android:paddingTop="4dp"
        android:paddingBottom="72dp"
        app:layout_constraintBottom_toTopOf="@id/fr_ads"
        app:layout_constraintTop_toBottomOf="@id/row_secondary_controls" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fr_ads"
        app:layout_constraintTop_toBottomOf="@id/row_secondary_controls">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.85"
            android:src="@drawable/ic_no_data" />

        <TextView
            android:id="@+id/tv_empty_title"
            style="@style/AppText.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="@string/no_matching_transactions" />

        <TextView
            android:id="@+id/btn_empty_action"
            style="@style/AppButton.SoftChip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ds_button_height_sm"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="20dp"
            android:text="@string/reset" />
    </LinearLayout>

    <!-- Scroll-to-Top Floating Button -->
    <ImageView
        android:id="@+id/fab_scroll_top"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="@dimen/ds_space_lg"
        android:layout_marginBottom="@dimen/ds_space_lg"
        android:background="@drawable/bg_fab_primary"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_up_clean"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fr_ads"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Compact Fixed Bottom Native Ad -->
    <FrameLayout
        android:id="@+id/fr_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:elevation="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
