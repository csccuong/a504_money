<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_canvas">

        <!-- Unified Navy Header -->
        <LinearLayout
            android:id="@+id/toolbar"
            style="@style/AppContainer.HeaderNavy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ds_space_lg"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_back"
                style="@style/AppButton.BackHeader"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_title"
                style="@style/AppText.ScreenTitleLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/currency_unit"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/iv_select"
                style="@style/AppButton.HeaderChip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/next"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Clean Search Input -->
        <LinearLayout
            android:id="@+id/search_card"
            style="@style/AppContainer.InputBox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/ds_space_lg"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/roboto_regular"
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCurrencyUnit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/ds_space_lg"
            android:paddingBottom="10dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/frAds"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/search_card"
            tools:listitem="@layout/item_curency_unit" />

        <FrameLayout
            android:id="@+id/frAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_canvas"
            android:elevation="6dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include layout="@layout/ads_shimmer_native_home" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
