<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- Clean Light Top App Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        style="@style/AppContainer.TopBarLight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_cancel"
            style="@style/AppButton.BackLight"
            android:src="@drawable/ic_cancel"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/AppText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/add_transaction" />

        <ImageView
            android:id="@+id/tv_save"
            style="@style/AppButton.BackLight"
            android:src="@drawable/ic_save"
            android:visibility="invisible" />
    </LinearLayout>

    <View
        android:id="@+id/top_divider"
        style="@style/AppDivider"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_save_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_lg"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <!-- Shared Reusable Segmented Tabs -->
            <include
                android:id="@+id/layout_tabs"
                layout="@layout/view_transaction_type_tabs" />

            <!-- Hero Amount Card -->
            <LinearLayout
                style="@style/AppContainer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_amount"
                    style="@style/AppText.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amount" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_currency"
                        style="@style/AppText.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$"
                        android:textColor="@color/brand_primary"
                        android:textSize="26sp" />

                    <EditText
                        android:id="@+id/et_amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/roboto_bold"
                        android:hint="0"
                        android:inputType="numberDecimal"
                        android:paddingVertical="4dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/ds_text_hero" />
                </LinearLayout>
            </LinearLayout>

            <!-- Native Media Small Ad (below Amount, above Category) -->
            <FrameLayout
                android:id="@+id/frAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md">

                <include layout="@layout/ads_shimmer_native_small" />
            </FrameLayout>

            <!-- Form Details Card -->
            <LinearLayout
                style="@style/AppContainer.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_category"
                    style="@style/AppText.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category" />

                <LinearLayout
                    android:id="@+id/category_view"
                    style="@style/AppContainer.InputBox"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_selected_category_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_food" />

                    <TextView
                        android:id="@+id/tv_selected_category"
                        style="@style/AppText.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/category_food"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_muted" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_auto_budget_hint"
                    style="@style/AppText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_green"
                    android:fontFamily="@font/roboto_bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/semantic_income"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_lender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_lender"
                        style="@style/AppText.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lender" />

                    <EditText
                        android:id="@+id/et_lender"
                        style="@style/AppContainer.InputBox"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_input_height"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/roboto_regular"
                        android:hint="@string/person_name_hint"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="@dimen/ds_text_body" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_note"
                    style="@style/AppText.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/note" />

                <EditText
                    android:id="@+id/et_note"
                    style="@style/AppContainer.InputBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/add_a_description"
                    android:paddingVertical="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="@dimen/ds_text_body" />

                <TextView
                    android:id="@+id/tv_date_title"
                    style="@style/AppText.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/date_time" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btn_date"
                        style="@style/AppContainer.InputBox"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ds_input_height"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_date"
                            style="@style/AppText.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/select_date"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_date"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_time"
                        style="@style/AppContainer.InputBox"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/ds_input_height"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_time"
                            style="@style/AppText.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/select_time"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Primary CTA -->
    <LinearLayout
        android:id="@+id/bottom_save_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_lg"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/ds_space_lg"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/ll_save"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_button_height"
            android:orientation="horizontal">

            <TextView
                style="@style/AppText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
