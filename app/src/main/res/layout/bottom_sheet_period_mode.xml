<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppContainer.BottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View style="@style/AppSheetHandle" />

    <!-- Header: Title + Quick Current Period Reset Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/AppText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_date_range" />

        <TextView
            android:id="@+id/btn_reset_current"
            style="@style/AppButton.SoftChip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/current_period"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 1: Week -->
    <LinearLayout
        android:id="@+id/row_period_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_category_chip_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title_week"
                style="@style/AppText.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/week" />

            <TextView
                android:id="@+id/tv_sub_week"
                style="@style/AppText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_week"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_brand"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 2: Month -->
    <LinearLayout
        android:id="@+id/row_period_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_category_chip_selected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title_month"
                style="@style/AppText.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/month"
                android:textColor="@color/brand_primary" />

            <TextView
                android:id="@+id/tv_sub_month"
                style="@style/AppText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_month"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_brand" />
    </LinearLayout>

    <!-- Option 3: Year -->
    <LinearLayout
        android:id="@+id/row_period_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_category_chip_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title_year"
                style="@style/AppText.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/year" />

            <TextView
                android:id="@+id/tv_sub_year"
                style="@style/AppText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_year"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_brand"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Option 4: Custom Date Range -->
    <LinearLayout
        android:id="@+id/row_period_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_category_chip_normal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title_custom"
                style="@style/AppText.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/custom_range" />

            <TextView
                android:id="@+id/tv_sub_custom"
                style="@style/AppText.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/select_date_range"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_check_custom"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_brand"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_arrow_custom"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_figma_arrow_right"
            app:tint="@color/text_muted" />
    </LinearLayout>
</LinearLayout>
