<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Header Row: Title + Quick Action Pill (Today) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_picker_title"
            style="@style/AppText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_date" />

        <TextView
            android:id="@+id/btn_jump_today"
            style="@style/AppButton.SoftChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/today" />
    </LinearLayout>

    <!-- Selected Date / Range Summary Strip -->
    <LinearLayout
        android:id="@+id/layout_range_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_stepper_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_range_start"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:textColor="@color/brand_primary" />

        <TextView
            style="@style/AppText.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="→"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_range_end"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:textColor="@color/brand_primary" />
    </LinearLayout>

    <!-- Month Navigation Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_prev_month"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_soft"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_chevron_left_clean"
            app:tint="@color/brand_primary" />

        <TextView
            android:id="@+id/tv_month_year"
            style="@style/AppText.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="November 2026" />

        <ImageView
            android:id="@+id/btn_next_month"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_soft"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_chevron_right_clean"
            app:tint="@color/brand_primary" />
    </LinearLayout>

    <!-- 7-Column Localized Weekday Labels -->
    <LinearLayout
        android:id="@+id/layout_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_wd_0"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_wd_1"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_wd_2"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_wd_3"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_wd_4"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_wd_5"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/tv_wd_6"
            style="@style/AppText.Micro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- 7x6 Calendar Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar_days"
        android:layout_width="match_parent"
        android:layout_height="244dp"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/AppButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:minHeight="0dp"
            android:text="@string/save" />
    </LinearLayout>

</LinearLayout>
