<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Header Row: Select time + Now quick chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/AppText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_time" />

        <TextView
            android:id="@+id/btn_now"
            style="@style/AppButton.SoftChip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/now" />
    </LinearLayout>

    <!-- Custom Dual-Column HH : MM Stepper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Hour Column -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stepper_pill"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/btn_hour_up"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_down_clean"
                app:tint="@color/brand_primary" />

            <TextView
                android:id="@+id/tv_hour_value"
                style="@style/AppText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:fontFamily="@font/roboto_bold"
                android:text="14"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <ImageView
                android:id="@+id/btn_hour_down"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_chevron_down_clean"
                app:tint="@color/brand_primary" />
        </LinearLayout>

        <TextView
            style="@style/AppText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:fontFamily="@font/roboto_bold"
            android:text=":"
            android:textColor="@color/brand_primary"
            android:textSize="30sp" />

        <!-- Minute Column -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stepper_pill"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/btn_minute_up"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_down_clean"
                app:tint="@color/brand_primary" />

            <TextView
                android:id="@+id/tv_minute_value"
                style="@style/AppText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:fontFamily="@font/roboto_bold"
                android:text="30"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <ImageView
                android:id="@+id/btn_minute_down"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:src="@drawable/ic_chevron_down_clean"
                app:tint="@color/brand_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Minute Presets (:00 :15 :30 :45) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_min_00"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text=":00"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/chip_min_15"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text=":15"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/chip_min_30"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text=":30"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/chip_min_45"
            style="@style/AppText.Caption"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_chip_normal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text=":45"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/AppButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/btn_confirm"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:minHeight="0dp"
            android:text="@string/save" />
    </LinearLayout>

</LinearLayout>
