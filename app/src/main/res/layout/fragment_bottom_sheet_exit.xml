<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppContainer.BottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View style="@style/AppSheetHandle" />

    <FrameLayout
        android:id="@+id/frAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/surface_card">

        <include layout="@layout/ads_shimmer_native_no_media" />
    </FrameLayout>

    <TextView
        android:id="@+id/close"
        style="@style/AppButton.Danger"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_button_height"
        android:layout_marginTop="14dp"
        android:text="@string/tap_here_to_exit" />
</LinearLayout>
