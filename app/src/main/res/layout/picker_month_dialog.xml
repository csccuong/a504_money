<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Header: Select Month + Clean Year Stepper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/AppText.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_month" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_stepper_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/btn_previous_year"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_left_clean"
                app:tint="@color/brand_primary" />

            <TextView
                android:id="@+id/tv_year"
                style="@style/AppText.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:paddingHorizontal="8dp"
                android:text="2026"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/btn_next_year"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ic_chevron_right_clean"
                app:tint="@color/brand_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4x3 Month Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:columnCount="4"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <TextView
            android:id="@+id/month_jan"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Jan" />

        <TextView
            android:id="@+id/month_feb"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Feb" />

        <TextView
            android:id="@+id/month_mar"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Mar" />

        <TextView
            android:id="@+id/month_apr"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Apr" />

        <TextView
            android:id="@+id/month_may"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="May" />

        <TextView
            android:id="@+id/month_jun"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Jun" />

        <TextView
            android:id="@+id/month_jul"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Jul" />

        <TextView
            android:id="@+id/month_aug"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Aug" />

        <TextView
            android:id="@+id/month_sep"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Sep" />

        <TextView
            android:id="@+id/month_oct"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Oct" />

        <TextView
            android:id="@+id/month_nov"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Nov" />

        <TextView
            android:id="@+id/month_dec"
            style="@style/MonthPickerItem"
            android:fontFamily="@font/roboto_bold"
            android:text="Dec" />
    </GridLayout>

    <!-- Footer Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            style="@style/AppButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/btn_save"
            style="@style/AppButton.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:minHeight="0dp"
            android:text="@string/save" />
    </LinearLayout>

</LinearLayout>
