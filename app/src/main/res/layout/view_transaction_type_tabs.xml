<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable 3-Tab Segmented Control: Expense | Income | Loan -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_transaction_tabs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_segmented_track"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/ll_expend"
        android:layout_width="0dp"
        android:layout_height="@dimen/ds_tab_height"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_expend"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_expense" />

        <TextView
            android:id="@+id/tv_expend_label"
            style="@style/AppText.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/expense"
            android:textSize="13sp" />

        <View
            android:id="@+id/indicator_expense"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_income"
        android:layout_width="0dp"
        android:layout_height="@dimen/ds_tab_height"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_income"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_income" />

        <TextView
            android:id="@+id/tv_income_label"
            style="@style/AppText.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/income"
            android:textSize="13sp" />

        <View
            android:id="@+id/indicator_income"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_loan"
        android:layout_width="0dp"
        android:layout_height="@dimen/ds_tab_height"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_loan"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_loan_tab" />

        <TextView
            android:id="@+id/tv_loan_label"
            style="@style/AppText.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/loan"
            android:textSize="13sp" />

        <View
            android:id="@+id/indicator_loan"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
