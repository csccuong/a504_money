    <!-- Onboarding & Guide -->
    <string name="note_continue1">ನಿಮ್ಮ ಹಣವನ್ನು ಸುಲಭವಾಗಿ ನಿರ್ವಹಿಸಿ</string>
    <string name="note_continue2">ನಿಮ್ಮ ಖರ್ಚನ್ನು ವ್ಯವಸ್ಥಿತಗೊಳಿಸಿ</string>
    <string name="note_continue3">ನಿಮ್ಮ ಆರ್ಥಿಕ ಪ್ರಗತಿಯನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ</string>
    <string name="note_continue4">ಗುರಿಗಳನ್ನು ಹೊಂದಿಸಿ ಮತ್ತು ಹೆಚ್ಚು ಉಳಿಸಿ</string>
    <string name="intro_slide_1_des">ಆದಾಯ, ವೆಚ್ಚ ಮತ್ತು ಬ್ಯಾಲೆನ್ಸ್ ಎಲ್ಲವನ್ನೂ ಒಂದೇ ಸ್ಥಳದಲ್ಲಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಿ.</string>
    <string name="intro_slide_2_des">ನಿಮ್ಮ ಹಣ ಎಲ್ಲಿಗೆ ಹೋಗುತ್ತಿದೆ ಎಂಬುದನ್ನು ನೋಡಲು ವಹಿವಾಟುಗಳನ್ನು ವರ್ಗೀಕರಿಸಿ</string>
    <string name="intro_slide_3_des">ಕಾಲಾನಂತರದಲ್ಲಿ ನಿಮ್ಮ ಆದಾಯ, ವೆಚ್ಚಗಳು ಮತ್ತು ಉಳಿತಾಯವನ್ನು ದೃಶ್ಯೀಕರಿಸಿ</string>
    <string name="intro_slide_4_des">ನಿಮ್ಮ ಬಜೆಟ್ ಯೋಜಿಸಿ, ಉಳಿತಾಯ ಗುರಿಗಳನ್ನು ನಿಗದಿಪಡಿಸಿ ಮತ್ತು ಉತ್ತಮ ಅಭ್ಯಾಸಗಳನ್ನು ಬೆಳೆಸಿಕೊಳ್ಳಿ</string>
    <string name="note_guide1">ನಿಮ್ಮ ವೆಚ್ಚವನ್ನು ನಿರ್ವಹಿಸಲು ‘ಬಜೆಟ್’ ಟ್ಯಾಪ್ ಮಾಡಿ</string>
    <string name="note_guide2">ಉಳಿದ ಬ್ಯಾಲೆನ್ಸ್ ಅನ್ನು ಒಂದೇ ನೋಟದಲ್ಲಿ ನೋಡಿ</string>
    <string name="note_guide3">ಬಜೆಟ್‌ಗಳ ನಡುವೆ ಸುಲಭವಾಗಿ ಬದಲಾಯಿಸಿ</string>
    <string name="note_guide4">ವೆಚ್ಚಗಳನ್ನು ವಿಶ್ಲೇಷಿಸಿ ಮತ್ತು ಸರಿಯಾದ ದಾರಿಯಲ್ಲಿರಿ</string>
