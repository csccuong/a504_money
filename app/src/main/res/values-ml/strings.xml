    <!-- Onboarding & Guide -->
    <string name="note_continue1">നിങ്ങളുടെ പണം എളുപ്പത്തിൽ കൈകാര്യം ചെയ്യുക</string>
    <string name="note_continue2">നിങ്ങളുടെ ചെലവുകൾ ക്രമീകരിക്കുക</string>
    <string name="note_continue3">നിങ്ങളുടെ സാമ്പത്തിക പുരോഗതി പിന്തുടരുക</string>
    <string name="note_continue4">ലക്ഷ്യങ്ങൾ നിശ്ചയിച്ച് കൂടുതൽ ലാഭിക്കുക</string>
    <string name="intro_slide_1_des">വരുമാനവും ചെലവുകളും ബാലൻസും ഒരേ സ്ഥലത്ത് ട്രാക്ക് ചെയ്യുക.</string>
    <string name="intro_slide_2_des">പണം എവിടേക്കാണ് പോകുന്നതെന്ന് കാണാൻ ഇടപാടുകൾ തരംതിരിക്കുക</string>
    <string name="intro_slide_3_des">കാലക്രമേണയുള്ള വരുമാനം, ചെലവുകൾ, സമ്പാദ്യം എന്നിവ ദൃശ്യവൽക്കരിക്കുക</string>
    <string name="intro_slide_4_des">ബജറ്റ് ആസൂത്രണം ചെയ്ത്, സമ്പാദ്യ ലക്ഷ്യങ്ങൾ സജ്ജമാക്കി മികച്ച ശീലങ്ങൾ വളർത്തുക</string>
    <string name="note_guide1">ചെലവുകൾ നിയന്ത്രിക്കാൻ ‘ബജറ്റ്’ ടാപ്പ് ചെയ്യൂ</string>
    <string name="note_guide2">ബാക്കിയുള്ള ബാലൻസ് ഒറ്റനോട്ടത്തിൽ കാണൂ</string>
    <string name="note_guide3">ബജറ്റുകൾക്കിടയിൽ എളുപ്പത്തിൽ മാറൂ</string>
    <string name="note_guide4">ചെലവുകൾ വിശകലനം ചെയ്ത് ശരിയായ പാതയിൽ തുടരൂ</string>
