    <!-- Onboarding & Guide -->
    <string name="note_continue1">உங்கள் பணத்தை எளிதாக நிர்வகிக்கவும்</string>
    <string name="note_continue2">உங்கள் செலவுகளை ஒழுங்கமைக்கவும்</string>
