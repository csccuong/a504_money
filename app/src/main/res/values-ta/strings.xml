    <string name="intro_slide_1_des">வருமானம், செலவுகள் மற்றும் இருப்பை ஒரே இடத்தில் கண்காணிக்கவும்.</string>
    <string name="intro_slide_2_des">பணம் எங்கே செல்கிறது என்பதை அறிய பரிவர்த்தனைகளை வகைப்படுத்தவும்</string>
    <string name="intro_slide_3_des">காலப்போக்கில் உங்கள் வருமானம், செலவுகள் மற்றும் சேமிப்பை காட்சிப்படுத்தவும்</string>
    <string name="intro_slide_4_des">பட்ஜெட்டைத் திட்டமிட்டு, சேமிப்பு இலக்குகளை அமைத்து, நல்ல பழக்கங்களை உருவாக்கவும்</string>
    <string name="note_guide1">உங்கள் செலவுகளை நிர்வகிக்க ‘பட்ஜெட்’ என்பதைத் தட்டவும்</string>
    <string name="note_guide2">மீதமுள்ள இருப்பை ஒரே பார்வையில் காணுங்கள்</string>
    <string name="note_guide3">பட்ஜெட்களுக்கு இடையே எளிதாக மாறுங்கள்</string>
    <string name="note_guide4">செலவுகளைப் பகுப்பாய்வு செய்து சரியான பாதையில் செல்லுங்கள்</string>
